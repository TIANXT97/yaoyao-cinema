<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 基础应用主题：纯白通透 -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/yy_paper</item>
        <item name="android:statusBarColor">@color/yy_paper</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Capacitor WebView 容器主题 -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/yy_paper</item>
        <item name="android:statusBarColor">@color/yy_paper</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- 启动屏主题（防止冷启动白屏闪烁） -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>

    <!-- 原生硬解播放器：全屏沉浸 + 纯黑背景 -->
    <style name="AppTheme.Player" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@color/yy_player_bg</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
